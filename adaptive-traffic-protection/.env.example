# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
ADMIN_API_KEY=gateway-admin-secret-key-change-in-production

# Operating mode: "adaptive" or "static"
GATEWAY_MODE=adaptive

# Application URLs (for local development without Docker)
APP_A_BASE_URL=http://localhost:8001
APP_B_BASE_URL=http://localhost:8002

# Logging
LOG_LEVEL=INFO

# Dashboard
DASHBOARD_GATEWAY_URL=http://localhost:8000
